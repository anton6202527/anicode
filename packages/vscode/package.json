{
  "name": "anicode-vscode",
  "displayName": "AniCode Zen",
  "description": "AniCode Zen —— 在 VSCode 侧边栏里使用通用型 Agent，软件工程能力重点强化（复用 @anicode/core）",
  "version": "0.0.1",
  "private": true,
  "publisher": "anicode",
  "author": "AniCode Zen",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "build": "node esbuild.mjs && node scripts/check-host-compatibility.mjs",
    "watch": "node esbuild.mjs --watch",
    "vscode:prepublish": "node esbuild.mjs --production && node scripts/check-host-compatibility.mjs",
    "check:host-compat": "node scripts/check-host-compatibility.mjs",
    "package": "cross-env ANICODE_CREDENTIAL_BACKEND=memory ANICODE_DISABLE_OS_KEYCHAIN=1 node scripts/package-vsix.mjs",
    "test": "cross-env ANICODE_LANG=zh ANICODE_CREDENTIAL_BACKEND=memory ANICODE_DISABLE_OS_KEYCHAIN=1 node --import tsx --test 'src/**/*.test.ts' 'scripts/**/*.test.mjs'",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "activationEvents": [
    "onView:anicode.chat"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "anicode",
          "title": "AniCode Zen",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "anicode": [
        {
          "id": "anicode.chat",
          "name": "对话",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "anicode.newSession",
        "title": "AniCode Zen: 新对话",
        "icon": "$(add)"
      },
      {
        "command": "anicode.pickModel",
        "title": "AniCode Zen: 选择模型",
        "icon": "$(list-selection)"
      },
      {
        "command": "anicode.resume",
        "title": "AniCode Zen: 恢复会话",
        "icon": "$(history)"
      },
      {
        "command": "anicode.focus",
        "title": "AniCode Zen: 打开对话面板"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "anicode.newSession",
          "when": "view == anicode.chat",
          "group": "navigation@1"
        },
        {
          "command": "anicode.pickModel",
          "when": "view == anicode.chat",
          "group": "navigation@2"
        },
        {
          "command": "anicode.resume",
          "when": "view == anicode.chat",
          "group": "navigation@3"
        }
      ]
    }
  },
  "dependencies": {
    "@anicode/core": "*",
    "@anicode/shared": "*"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/vscode": "1.125.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2"
  }
}
