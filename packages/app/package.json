{
  "name": "@anicode/app",
  "version": "0.0.1",
  "private": true,
  "description": "AniCode Zen 桌面应用（Electron）—— ChatGPT 风格界面 + 插件市场，复用 @anicode/core",
  "author": "AniCode Zen",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "ANICODE_LANG=zh node --import tsx --test 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pack": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder"
  },
  "build": {
    "appId": "dev.anicode.app",
    "productName": "AniCode Zen",
    "electronVersion": "43.1.0",
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "files": ["out/**/*", "package.json"],
    "extraMetadata": { "main": "out/main/index.js" },
    "npmRebuild": false,
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": ["nsis"]
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Development"
    }
  },
  "dependencies": {
    "@anicode/core": "*",
    "@anicode/shared": "*",
    "@ast-grep/lang-go": "^0.0.6",
    "@ast-grep/lang-java": "^0.0.7",
    "@ast-grep/lang-python": "^0.0.6",
    "@ast-grep/lang-rust": "^0.0.7",
    "@ast-grep/napi": "^0.45.0",
    "@napi-rs/keyring": "^1.3.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.7",
    "electron-vite": "^5.0.0",
    "react": "^18.3.1",
    "react-dom": "^19.2.8",
    "vite": "^8.1.5"
  }
}
