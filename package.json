{
  "name": "anicode-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:tui": "tsx packages/tui/src/cli.tsx --cwd . --sessions .anicode-dev/sessions --debug-log .anicode-dev/tui.jsonl",
    "dev:tui:demo": "tsx packages/tui/src/cli.tsx --demo --cwd . --sessions .anicode-dev/sessions --debug-log .anicode-dev/tui.jsonl",
    "build:cli": "npm run build --workspace anicode",
    "dev:app": "npm run dev --workspace @anicode/app",
    "build:app": "npm run build --workspace @anicode/app",
    "build:vscode": "npm run build --workspace anicode-vscode",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "cross-env ANICODE_CREDENTIAL_BACKEND=memory npm run test --workspaces --if-present",
    "eval": "npm run eval --workspace @anicode/eval --",
    "codegen": "npm run codegen --workspace @anicode/sdk",
    "codegen:check": "npm run codegen:check --workspace @anicode/sdk",
    "lint": "eslint \"packages/*/src/**/*.{ts,tsx}\" --max-warnings 0",
    "lint:fix": "eslint \"packages/*/src/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx}\" \"*.{json,mjs}\"",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,tsx}\" \"*.{json,mjs}\"",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build:cli && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.9.5",
    "ink": "^7.1.1",
    "react": "^19.2.0",
    "react-devtools-core": "^7.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.64.0"
  },
  "allowScripts": {
    "@ast-grep/lang-go@0.0.6": true,
    "@ast-grep/lang-java@0.0.7": true,
    "@ast-grep/lang-python@0.0.6": true,
    "@ast-grep/lang-rust@0.0.7": true,
    "electron-winstaller@5.4.0": true,
    "esbuild": true
  }
}
