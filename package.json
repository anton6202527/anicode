{
  "name": "anicode-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=22.15.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.15.0",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=10.9.2",
      "onFail": "error"
    }
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:tui": "tsx packages/tui/src/cli.tsx --cwd . --sessions .anicode-dev/sessions --debug-log .anicode-dev/tui.jsonl",
    "dev:tui:demo": "tsx packages/tui/src/cli.tsx --demo --cwd . --sessions .anicode-dev/sessions --debug-log .anicode-dev/tui.jsonl",
    "dev:trust": "tsx packages/tui/src/cli.tsx trust grant --cwd .",
    "dev:trust:status": "tsx packages/tui/src/cli.tsx trust status --cwd .",
    "build:cli": "npm run build --workspace anicode",
    "dev:app": "npm run dev --workspace @anicode/app",
    "build:app": "npm run build --workspace @anicode/app",
    "build:vscode": "npm run build --workspace anicode-vscode",
    "size:check": "node scripts/check-bundle-size.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "cross-env ANICODE_CREDENTIAL_BACKEND=memory ANICODE_DISABLE_OS_KEYCHAIN=1 npm run test --workspaces --if-present",
    "eval": "npm run eval --workspace @anicode/eval --",
    "codegen": "npm run codegen --workspace @anicode/sdk",
    "codegen:check": "npm run codegen:check --workspace @anicode/sdk",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "audit:build": "node scripts/audit-build-dependencies.mjs",
    "audit:signatures": "npm audit signatures",
    "audit:install-scripts": "node scripts/audit-install-scripts.mjs",
    "rebuild:trusted": "node scripts/rebuild-trusted-dependencies.mjs",
    "test:release-contract": "cross-env ANICODE_CREDENTIAL_BACKEND=memory ANICODE_DISABLE_OS_KEYCHAIN=1 node --test scripts/audit-install-scripts.test.mjs scripts/release-workflow.test.mjs",
    "smoke:cli": "npm run build:cli && node scripts/smoke-cli-package.mjs",
    "verify:release": "cross-env ANICODE_CREDENTIAL_BACKEND=memory ANICODE_DISABLE_OS_KEYCHAIN=1 node scripts/verify-release.mjs",
    "lint": "eslint \"packages/*/src/**/*.{ts,tsx}\" --max-warnings 0",
    "lint:fix": "eslint \"packages/*/src/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx}\" \"*.{json,mjs}\"",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,tsx}\" \"*.{json,mjs}\"",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "node scripts/refuse-local-publish.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "ink": "^7.1.1",
    "prettier": "^3.9.5",
    "react": "^19.2.0",
    "react-devtools-core": "^7.0.1",
    "tsx": "^4.23.5",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.64.0"
  },
  "allowScripts": {
    "@ast-grep/lang-go@0.0.6": true,
    "@ast-grep/lang-java@0.0.7": true,
    "@ast-grep/lang-python@0.0.6": true,
    "@ast-grep/lang-rust@0.0.7": true,
    "@vscode/vsce-sign@2.0.9": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "keytar@7.9.0": true
  }
}
